/* The open files (native/kernel/io.c): reopened by path on load; the disc's
 * by their directory entry; the host's by their path in the hdd folder
 * (FILE v4; before, the host's absolute path). */
NC_SECTION(FILE)

NC_REC(NcDiscFile, 12)
NC_F(NcDiscFile, sector, U32, 1, 1, 0)
NC_F(NcDiscFile, size, U32, 1, 1, 0)
NC_F(NcDiscFile, attr, U8, 1, 1, 0)
NC_END(NcDiscFile)

NC_REC(DirEntry, 80)
NC_F(DirEntry, name, U8, 64, 1, 0)
NC_F(DirEntry, size, U64, 1, 1, 0)
NC_F(DirEntry, dir, BOOL, 1, 1, 0)
NC_END(DirEntry)

NC_REC(NcFile, 1552)
NC_F(NcFile, used, BOOL, 1, 1, 0)
NC_F(NcFile, kind, U32, 1, 1, 0)
NC_F(NcFile, path, U8, 512, 1, 0)
NC_R(NcFile, disc, NcDiscFile, 1, 1, 0)
NC_F(NcFile, host, U8, 512, 1, 0)
NC_SKIP(NcFile, fd)
NC_F(NcFile, is_dir, BOOL, 1, 1, 0)
NC_F(NcFile, pos, U64, 1, 1, 0)
NC_F(NcFile, dir_next, U32, 1, 1, 0)
NC_F(NcFile, mask, U8, 128, 1, 0)
NC_F(NcFile, partition, I32, 1, 1, 0)
NC_F(NcFile, old_path, U8, 320, 1, 0)
NC_F(NcFile, old_size, U64, 1, 1, 0)
NC_F(NcFile, wrote, BOOL, 1, 1, 0)
NC_SKIP(NcFile, listing)
NC_F(NcFile, nlisting, U32, 1, 1, 0)
NC_F(NcFile, async, BOOL, 1, 1, 0)
NC_F(NcFile, can_write, BOOL, 1, 1, 0)
NC_F(NcFile, del, BOOL, 1, 2, 0)
NC_F(NcFile, no_buffering, BOOL, 1, 3, 0)
NC_END(NcFile)

NC_REC(NcLink, 320)
NC_F(NcLink, name, U8, 64, 1, 0)
NC_F(NcLink, target, U8, 256, 1, 0)
NC_END(NcLink)

NC_REC(NcFileState, 4)
NC_F(NcFileState, nfiles, U32, 1, 1, 0)
NC_END(NcFileState)
