/* The kernel's own state: NcKernel's scalars, the handle table and the pool
 * (native/kernel/kstate.c). Threads are THRD (thread.def). */
NC_SECTION(KERN)

NC_REC(NcHandle, 8)
NC_F(NcHandle, object, U32, 1, 1, 0)
NC_F(NcHandle, type, U32, 1, 1, 0)
NC_END(NcHandle)

NC_REC(NcRange, 8)
NC_F(NcRange, va, U32, 1, 1, 0)
NC_F(NcRange, len, U32, 1, 1, 0)
NC_END(NcRange)

NC_REC(NcKernel, 573808)
NC_SKIP(NcKernel, vm)
NC_SKIP(NcKernel, cpu)
NC_SKIP(NcKernel, disc)
NC_SKIP(NcKernel, xbe_file)
NC_SKIP(NcKernel, xbe_fd)
NC_F(NcKernel, xbe_base, U32, 1, 1, 0)
NC_F(NcKernel, xbe_size, U32, 1, 1, 0)
NC_SKIP(NcKernel, game_region)
NC_F(NcKernel, kprocess, U32, 1, 1, 0)
NC_SKIP(NcKernel, tramp_va)
NC_SKIP(NcKernel, data_va)
NC_SKIP(NcKernel, impl)
NC_SKIP(NcKernel, stop_va)
NC_SKIP(NcKernel, thread_return_va)
NC_SKIP(NcKernel, dpc_return_va)
NC_SKIP(NcKernel, callout_return_va)
NC_SKIP(NcKernel, apc_return_va)
NC_SKIP(NcKernel, idt_va)
NC_SKIP(NcKernel, trap_va)
NC_SKIP(NcKernel, seh_return_va)
NC_F(NcKernel, code_next, U32, 1, 1, 0)
NC_F(NcKernel, defer_replayed, U64, 1, 1, 0)
NC_F(NcKernel, apu_spins, U64, 1, 1, 0)
NC_SKIP(NcKernel, seh_nested_va)
NC_SKIP(NcKernel, seh_collided_va)
NC_F(NcKernel, cr2, U32, 1, 1, 0)
NC_F(NcKernel, page_faults, U64, 1, 1, 0)
NC_F(NcKernel, vm_commits, U64, 1, 1, 0)
NC_F(NcKernel, vm_decommits, U64, 1, 1, 0)
NC_SKIP(NcKernel, frame)
NC_SKIP(NcKernel, in_call)
NC_SKIP(NcKernel, call_pop)
NC_SKIP(NcKernel, redirected)
NC_SKIP(NcKernel, kpcr_va)
NC_SKIP(NcKernel, type_va)
NC_SKIP(NcKernel, pool_va)
NC_SKIP(NcKernel, pool_len)
NC_R(NcKernel, pool_free, NcRange, 8192, 1, 0)
NC_F(NcKernel, pool_nfree, U32, 1, 1, 0)
NC_F(NcKernel, pool_ex, U32, 1, 1, 0)
NC_F(NcKernel, pool_ob, U32, 1, 1, 0)
NC_F(NcKernel, pool_lost, U32, 1, 1, 0)
NC_R(NcKernel, handles, NcHandle, 4096, 1, 0)
NC_R(NcKernel, handles_more, NcHandle, 12288, 2, 0)
NC_SKIP(NcKernel, handle_table)
NC_SKIP(NcKernel, threads)
NC_F(NcKernel, threads_hi, U32, 1, 1, 0)
NC_SKIP(NcKernel, current)
NC_F(NcKernel, resched, BOOL, 1, 1, 0)
NC_F(NcKernel, next_stack_va, U32, 1, 1, 0)
NC_SKIP(NcKernel, stack_free)
NC_SKIP(NcKernel, nstack_free)
NC_F(NcKernel, next_thread_id, U32, 1, 1, 0)
NC_F(NcKernel, timer_due_ns, U64, 1, 1, 0)
NC_F(NcKernel, wait_due_ns, U64, 1, 1, 0)
NC_SKIP(NcKernel, slice_thread)
NC_F(NcKernel, slice_due_ns, U64, 1, 1, 0)
NC_F(NcKernel, ready_clock, U64, 1, 1, 0)
NC_SKIP(NcKernel, dpc_thread)
NC_F(NcKernel, in_dpc, BOOL, 1, 1, 0)
NC_F(NcKernel, dpc_saved_irql, U8, 1, 1, 0)
NC_F(NcKernel, irq_obj, U32, 16, 1, 0)
NC_SKIP(NcKernel, isr_return_va)
NC_SKIP(NcKernel, isr_thread)
NC_F(NcKernel, in_isr, BOOL, 1, 1, 0)
NC_F(NcKernel, isr_saved_irql, U8, 1, 1, 0)
NC_SKIP(NcKernel, isr_interrupted)
NC_SKIP(NcKernel, resume_first)
NC_F(NcKernel, force_switch, BOOL, 1, 1, 0)
NC_F(NcKernel, interrupts, U64, 1, 1, 0)
NC_SKIP(NcKernel, hle_hook)
NC_SKIP(NcKernel, hle_after_sysop)
NC_SKIP(NcKernel, hle_keep)
NC_SKIP(NcKernel, hle_keep_wait)
NC_SKIP(NcKernel, stop)
NC_SKIP(NcKernel, stop_reason)
NC_SKIP(NcKernel, relaunch)
