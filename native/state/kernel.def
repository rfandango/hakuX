NC_SKIP(NcKernel, image_path)
NC_F(NcKernel, calls, U64, 1, 1, 0)
NC_F(NcKernel, first_ordinal, U32, 1, 1, 0)
NC_END(NcKernel)

/* the kernel modules' own (kstate.c gathers them) */
NC_REC(NcKState, 56)
NC_F(NcKState, boot_ns, U64, 1, 1, 0)
NC_F(NcKState, time_offset, U64, 1, 1, 0)
NC_F(NcKState, guest_ns, U64, 1, 1, 0)
NC_F(NcKState, guest_cycles, U64, 1, 1, 0)
NC_F(NcKState, x87_single, BOOL, 1, 1, 0)
NC_F(NcKState, av_saved, U32, 1, 1, 0)
NC_F(NcKState, isr_line, U8, 1, 1, 0)
NC_F(NcKState, irq_enabled, U32, 1, 1, 0)
NC_F(NcKState, irq_lines, U32, 1, 1, 0)
NC_END(NcKState)
