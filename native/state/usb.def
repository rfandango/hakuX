/* USB (native/dev/ohci.c): the OHCI controller's registers, then per root
 * port whether a device (a controller's hub) was there, with the hub's
 * state and its ports, and per hub port whether a controller was there,
 * with its state. */
NC_SECTION(USB)

NC_REC(Ohci, NC_ABI_SIZE(264, 272))
NC_SKIP(Ohci, vm)
NC_SKIP(Ohci, lock)
NC_SKIP(Ohci, run)
NC_F(Ohci, ctl, U32, 1, 1, 0)
NC_F(Ohci, status, U32, 1, 1, 0)
NC_F(Ohci, intr_status, U32, 1, 1, 0)
NC_F(Ohci, intr, U32, 1, 1, 0)
NC_F(Ohci, hcca, U32, 1, 1, 0)
NC_F(Ohci, ctrl_head, U32, 1, 1, 0)
NC_F(Ohci, ctrl_cur, U32, 1, 1, 0)
NC_F(Ohci, bulk_head, U32, 1, 1, 0)
NC_F(Ohci, bulk_cur, U32, 1, 1, 0)
NC_F(Ohci, per_cur, U32, 1, 1, 0)
NC_F(Ohci, done, U32, 1, 1, 0)
NC_F(Ohci, done_count, I32, 1, 1, 0)
NC_F(Ohci, fi, U32, 1, 1, 0)
NC_F(Ohci, fsmps, U32, 1, 1, 0)
NC_F(Ohci, fit, U32, 1, 1, 0)
NC_F(Ohci, pstart, U32, 1, 1, 0)
NC_F(Ohci, lst, U32, 1, 1, 0)
NC_F(Ohci, frame_number, U16, 1, 1, 0)
NC_SKIP(Ohci, frame_t0_ns)
NC_F(Ohci, rhdesc_a, U32, 1, 1, 0)
NC_F(Ohci, rhdesc_b, U32, 1, 1, 0)
NC_F(Ohci, rhstatus, U32, 1, 1, 0)
NC_F(Ohci, port, U32, 4, 1, 0)
NC_SKIP(Ohci, dev)
NC_F(Ohci, irq, BOOL, 1, 1, 0)
NC_F(Ohci, frames, U64, 1, 1, 0)
NC_F(Ohci, tds, U64, 1, 1, 0)
NC_END(Ohci)

NC_REC(NcUsbDev, 640)
NC_SKIP(NcUsbDev, name)
NC_F(NcUsbDev, addr, U8, 1, 1, 0)
NC_F(NcUsbDev, config, U8, 1, 1, 0)
NC_SKIP(NcUsbDev, low_speed)
NC_SKIP(NcUsbDev, dev_desc)
NC_SKIP(NcUsbDev, dev_desc_len)
NC_SKIP(NcUsbDev, cfg_desc)
NC_SKIP(NcUsbDev, cfg_desc_len)
NC_SKIP(NcUsbDev, strings)
NC_SKIP(NcUsbDev, nstrings)
NC_SKIP(NcUsbDev, control)
NC_SKIP(NcUsbDev, data)
NC_SKIP(NcUsbDev, find)
NC_SKIP(NcUsbDev, reset)
NC_SKIP(NcUsbDev, opaque)
NC_F(NcUsbDev, setup, U8, 8, 1, 0)
NC_F(NcUsbDev, buf, U8, 512, 1, 0)
NC_F(NcUsbDev, len, I32, 1, 1, 0)
NC_F(NcUsbDev, pos, I32, 1, 1, 0)
NC_F(NcUsbDev, in, BOOL, 1, 1, 0)
NC_F(NcUsbDev, data_stage, BOOL, 1, 1, 0)
NC_F(NcUsbDev, stalled, BOOL, 1, 1, 0)
NC_F(NcUsbDev, pending_addr, I32, 1, 1, 0)
NC_END(NcUsbDev)

NC_REC(NcUsbHubState, 24)
NC_F(NcUsbHubState, nports, U32, 1, 1, 0)
NC_F(NcUsbHubState, status, U16, 5, 1, 0)
NC_F(NcUsbHubState, change, U16, 5, 1, 0)
NC_END(NcUsbHubState)
