/* The guest's threads: the table's slots in use, each with its CPU context
 * and queued APCs (native/kernel/kstate.c). */
NC_SECTION(THRD)

NC_REC(NcWait, 280)
NC_F(NcWait, objects, U32, 64, 1, 0)
NC_F(NcWait, count, U32, 1, 1, 0)
NC_F(NcWait, wait_all, BOOL, 1, 1, 0)
NC_F(NcWait, deadline_ns, U64, 1, 1, 0)
NC_F(NcWait, cs, U32, 1, 1, 0)
NC_F(NcWait, alertable, BOOL, 1, 1, 0)
NC_END(NcWait)

NC_REC(NcApc, 20)
NC_F(NcApc, kapc, U32, 1, 1, 0)
NC_F(NcApc, normal, U32, 1, 1, 0)
NC_F(NcApc, ctx, U32, 1, 1, 0)
NC_F(NcApc, a1, U32, 1, 1, 0)
NC_F(NcApc, a2, U32, 1, 1, 0)
NC_END(NcApc)

NC_REC(NcApcChain, 32)
NC_R(NcApcChain, cur, NcApc, 1, 1, 0)
NC_F(NcApcChain, has_cur, BOOL, 1, 1, 0)
NC_F(NcApcChain, stage, U8, 1, 1, 0)
NC_F(NcApcChain, in_apc, BOOL, 1, 1, 0)
NC_F(NcApcChain, esp, U32, 1, 1, 0)
NC_F(NcApcChain, eip, U32, 1, 1, 0)
NC_END(NcApcChain)

NC_REC(NcSeh, 28)
NC_F(NcSeh, unwind, BOOL, 1, 1, 0)
NC_F(NcSeh, base, U32, 1, 1, 0)
NC_F(NcSeh, rec, U32, 1, 1, 0)
NC_F(NcSeh, ctx, U32, 1, 1, 0)
NC_F(NcSeh, reg, U32, 1, 1, 0)
NC_F(NcSeh, nested, U32, 1, 1, 0)
NC_F(NcSeh, target, U32, 1, 1, 0)
NC_END(NcSeh)

NC_REC(NcCpuState, 632)
NC_F(NcCpuState, rip, U64, 1, 1, 0)
NC_F(NcCpuState, gregs, U64, 16, 1, 0)
NC_F(NcCpuState, pf_raw, U32, 1, 1, 0)
NC_F(NcCpuState, af_raw, U32, 1, 1, 0)
NC_F(NcCpuState, flags, U8, 48, 1, 0)
NC_F(NcCpuState, xmm, U64, 32, 1, 0)
NC_F(NcCpuState, mm, U64, 16, 1, 0)
NC_F(NcCpuState, mxcsr, U32, 1, 1, 0)
NC_F(NcCpuState, fcw, U16, 1, 1, 0)
NC_F(NcCpuState, ftw, U8, 1, 1, 0)
NC_F(NcCpuState, es_idx, U16, 1, 1, 0)
NC_F(NcCpuState, cs_idx, U16, 1, 1, 0)
NC_F(NcCpuState, ss_idx, U16, 1, 1, 0)
NC_F(NcCpuState, ds_idx, U16, 1, 1, 0)
NC_F(NcCpuState, gs_idx, U16, 1, 1, 0)
NC_F(NcCpuState, fs_idx, U16, 1, 1, 0)
NC_F(NcCpuState, es_cached, U32, 1, 1, 0)
NC_F(NcCpuState, cs_cached, U32, 1, 1, 0)
NC_F(NcCpuState, ss_cached, U32, 1, 1, 0)
NC_F(NcCpuState, ds_cached, U32, 1, 1, 0)
NC_F(NcCpuState, gs_cached, U64, 1, 1, 0)
NC_F(NcCpuState, fs_cached, U64, 1, 1, 0)
NC_END(NcCpuState)

NC_REC(NcThread, 2880)
NC_F(NcThread, state, U32, 1, 1, 0)
NC_F(NcThread, ethread, U32, 1, 1, 0)
NC_F(NcThread, id, U32, 1, 1, 0)
NC_F(NcThread, priority, I32, 1, 1, 0)
NC_F(NcThread, stack_base, U32, 1, 1, 0)
NC_F(NcThread, stack_limit, U32, 1, 1, 0)
NC_F(NcThread, tib_base, U32, 1, 2, 0)
NC_F(NcThread, frame_top, U32, 1, 2, 0)
NC_F(NcThread, exception_list, U32, 1, 1, 0)
NC_R(NcThread, wait, NcWait, 1, 1, 0)
NC_F(NcThread, suspend, U32, 1, 1, 0)
NC_F(NcThread, callout_ret, U32, 4, 1, 0)
NC_F(NcThread, callout_esp, U32, 4, 1, 0)
NC_F(NcThread, callout_irql, U8, 4, 1, 0)
NC_F(NcThread, ncallouts, U32, 1, 1, 0)
NC_SKIP(NcThread, apcs)
NC_F(NcThread, napcs, U32, 1, 1, 0)
NC_SKIP(NcThread, apc_cap)
NC_R(NcThread, apc, NcApcChain, 1, 1, 0)
NC_R(NcThread, apc_outer, NcApcChain, 4, 1, 0)
NC_F(NcThread, apc_nest, U32, 1, 1, 0)
NC_R(NcThread, seh, NcSeh, 8, 1, 0)
NC_F(NcThread, nseh, U32, 1, 1, 0)
NC_F(NcThread, fresh, BOOL, 1, 1, 0)
NC_F(NcThread, ready_seq, U64, 1, 1, 0)
NC_F(NcThread, run_seq, U64, 1, 1, 0)
NC_F(NcThread, slice_used_ns, U64, 1, 1, 0)
NC_F(NcThread, slice_start_ns, U64, 1, 1, 0)
NC_F(NcThread, slice_expired, BOOL, 1, 1, 0)
NC_F(NcThread, boost, I32, 1, 3, 0)
NC_F(NcThread, no_boost, BOOL, 1, 3, 0)
NC_SKIP(NcThread, ctx)
NC_END(NcThread)

/* the table's thread pointers, as slots (-1: none) */
NC_REC(NcThreadRefs, 28)
NC_F(NcThreadRefs, current, I32, 1, 1, 0)
NC_F(NcThreadRefs, slice_thread, I32, 1, 1, 0)
NC_F(NcThreadRefs, dpc_thread, I32, 1, 1, 0)
NC_F(NcThreadRefs, isr_thread, I32, 1, 1, 0)
NC_F(NcThreadRefs, isr_interrupted, I32, 1, 1, 0)
NC_F(NcThreadRefs, resume_first, I32, 1, 1, 0)
NC_F(NcThreadRefs, point, U8, 1, 1, 0)
NC_END(NcThreadRefs)
