# hakuX's core info for RetroArch.
# savestate = "false": with no save states RetroArch never runs ahead,
# which would load a second hakuX into its process.
display_name = "Microsoft - Xbox (hakuX)"
authors = "hakuX contributors"
supported_extensions = "iso|chd"
corename = "hakuX"
categories = "Emulator"
license = "GPLv3+"
permissions = ""
display_version = "dev"
manufacturer = "Microsoft"
systemname = "Xbox"
systemid = "xbox"
database = "Microsoft - Xbox"
supports_no_game = "false"
needs_fullpath = "true"
savestate = "false"
savestate_features = "null"
cheats = "false"
input_descriptors = "true"
memory_descriptors = "false"
libretro_saves = "false"
core_options = "true"
core_options_version = "2.0"
load_subsystem = "false"
hw_render = "true"
required_hw_api = "Vulkan >= 1.3"
is_experimental = "true"
description = "Original Xbox games: x86 code on a FEX JIT, a reimplemented Xbox kernel (no BIOS or hard disk image), the NV2A drawn through Vulkan and the MCPX APU."
notes = "(!) ARM64 Linux with Vulkan 1.3; RetroArch's vulkan video driver.|(!) No BIOS, MCPX ROM or hard disk image: the console's disk and caches go in the save directory (hdd/, cache/).|Save states, rewind and run-ahead are not supported."
