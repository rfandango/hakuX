<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- The games' rumble, on the controllers (and a handheld's body). -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- hakuX's releases on GitHub: the check for a newer one and its APK
       (data/Updates.kt), installed by the system installer, which asks. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- The console's network (native/net, data/Network.kt): the local network's
       broadcast address, and the multicast lock its system link broadcasts
       need on Wi-Fi. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- Nearby system link (data/Nearby.kt, NearbyService): over Wi-Fi Direct,
       with no router, found over Bluetooth LE. Nearby devices (Android 13)
       and Bluetooth (12), the precise location before them; the service
       keeps the link while games run. -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
  <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
    android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
    android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
    android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application
    android:name=".HakuXApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="false"
    android:appCategory="game"
    android:supportsRtl="true"
    android:theme="@style/Theme.HakuX">

    <!-- The app's screens (Compose) and the entry for frontends' launches.
         singleTop: a frontend's launch while the library is open comes to
         it (onNewIntent); Android would otherwise only bring it forward
         when the intents match but for their extras (rom_path). -->
    <activity
      android:name=".LauncherActivity"
      android:launchMode="singleTop"
      android:screenOrientation="fullSensor"
      android:windowSoftInputMode="adjustResize|stateHidden"
      android:exported="true">

      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="file" />
        <data android:scheme="content" />
        <data android:mimeType="*/*" />
      </intent-filter>
    </activity>

    <!-- A title's quick reboot into another of its XBEs: the core starts
         again in a new process once the old one is gone, the game's last
         frame on screen meanwhile. -->
    <activity
      android:name=".RelaunchActivity"
      android:theme="@style/Theme.HakuX.Game"
      android:screenOrientation="sensorLandscape"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:exported="false" />

    <!-- Nearby play's link, kept while games run. -->
    <service
      android:name=".NearbyService"
      android:foregroundServiceType="connectedDevice"
      android:exported="false" />

    <!-- The system installer's answers about an update (data/Updates.kt). -->
    <receiver
      android:name=".data.UpdateInstallReceiver"
      android:exported="false" />

    <!-- The core: libhakuxcore.so on SDL3, in its own process. -->
    <activity
      android:name=".NativeCoreActivity"
      android:theme="@style/Theme.HakuX.Game"
      android:screenOrientation="sensorLandscape"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
      android:hardwareAccelerated="true"
      android:process=":native"
      android:exported="false">

      <meta-data
        android:name="SDL_MAIN_LIBRARY"
        android:value="hakuxcore" />
    </activity>

  </application>
</manifest>
